{
  "name": "campus-helpdesk",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,analytics npm:dev:api npm:dev:web npm:dev:analytics",
    "dev:api": "node --watch server.js",
    "dev:web": "vite --host 0.0.0.0",
    "dev:analytics": "python3 analytics_app.py",
    "build": "vite build",
    "start": "node server.js",
    "test": "node --test domain.test.js",
    "test:python": "python3 -m unittest analytics_test -v",
    "lint": "eslint *.js *.jsx",
    "check": "pnpm test && pnpm test:python && pnpm lint && pnpm build",
    "test:integration": "node --test integration.test.js",
    "smoke": "node smoke.js"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "graphql": "^16.11.0",
    "graphql-http": "^1.22.4",
    "gsap": "^3.15.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.17.0",
    "mysql2": "^3.14.4",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "zod": "^4.1.11",
    "@tanstack/react-query": "^5.90.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "vite": "^7.1.7",
    "@eslint/js": "^9.39.1",
    "globals": "^16.5.0"
  }
}
